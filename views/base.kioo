<!-- La mise en page : le squelette commun à toutes les pages du site.
     Chaque page s'y place par <k:layout name="base">, et remplit les emplacements <k:block>.

     Chaque contrôleur donne « langue », « t » (les textes de l'interface dans
     cette langue), « rubrique » (pour marquer le lien du menu) et « adresses »
     (la même page dans chaque langue). Voir SiteController::page().

     Ces commentaires ne sont jamais envoyés au visiteur. -->
<!DOCTYPE html>
<html lang="{langue}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title><k:block name="titre">{t.site.slogan}</k:block> — Wazi</title>
    <meta name="description" content="{t.site.description}">
    <!-- La même page dans l'autre langue : les moteurs de recherche proposent la bonne. -->
    <link rel="alternate" hreflang="fr" href="{adresses.fr}">
    <link rel="alternate" hreflang="en" href="{adresses.en}">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/app.css">
    <!-- Chargé tout de suite : il applique le thème choisi sans que la page ne clignote. -->
    <script src="/theme.js"></script>
    <!-- wazi.js : un lien marqué k:update ne remplace que des morceaux de la page
         (les k:zone). site.js : remonter en haut d'une page de documentation. -->
    <script src="/wazi.js" defer></script>
    <script src="/site.js" defer></script>
</head>
<body>
<a class="evitement" href="#contenu">{t.site.evitement}</a>

<header class="bandeau">
    <!-- « large » : sur les pages du guide, le bandeau s'aligne sur les trois colonnes. -->
    <div class="conteneur {(large ?? false) ? 'large' : ''}">
        <a class="marque" href="/{langue}" aria-label="Wazi, {t.site.slogan}">
            <!-- Le signe de Wazi : deux panneaux de verre qui forment un W. -->
            <svg viewBox="0 0 76 56" fill="none" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path class="panneau" d="M6 8 L24 48 L40 14"/>
                <path class="panneau clair" d="M36 14 L52 48 L70 8"/>
            </svg>
            wazi
        </a>

        <div class="navigation">
            <nav class="menu" aria-label="{t.menu.principal}">
                <!-- aria-current marque le lien de la rubrique affichée ; quand la valeur est null, Kioo retire l'attribut. -->
                <a href="/{langue}/docs" aria-current="{rubrique == 'guide' ? 'page' : null}">{t.menu.guide}</a>
                <a href="/{langue}/{t.journal.adresse}" aria-current="{rubrique == 'journal' ? 'page' : null}">{t.menu.journal}</a>
                <a href="https://github.com/wazi-php/wazi" rel="noopener">{t.menu.github}</a>
            </nav>

            <!-- Une zone : quand on passe d'une page du guide à une autre sans recharger,
                 ce lien est remplacé lui aussi, pour mener à la bonne page dans l'autre langue. -->
            <span k:zone="langue">
                <a class="bouton-langue" href="{adresses[autre_langue]}" hreflang="{autre_langue}" lang="{autre_langue}" aria-label="{t.menu.langue}">{t.menu.langue_court}</a>
            </span>

            <!-- Caché tant que le script n'est pas chargé : sans JavaScript, le
                 thème suit simplement le réglage de l'appareil. -->
            <button type="button" class="bouton-theme" id="theme" hidden aria-label="{t.menu.theme}">
                <svg class="lune" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
                <svg class="soleil" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
            </button>
        </div>
    </div>
</header>

<main id="contenu" class="conteneur {(large ?? false) ? 'large' : ''}">
    <k:block name="content"></k:block>
</main>

<footer class="pied">
    <div class="conteneur {(large ?? false) ? 'large' : ''}">
        <p>{t.pied.licence} © {annee}</p>
        <p class="pied-liens">
            <a href="https://github.com/wazi-php/site" rel="noopener">{t.pied.construit} {t.pied.source}</a>
            <a href="https://github.com/wazi-php/wazi/blob/main/CONTRIBUTING.md" rel="noopener">{t.pied.contribuer}</a>
            <a href="https://github.com/wazi-php/wazi/blob/main/SECURITY.md" rel="noopener">{t.pied.securite}</a>
        </p>
    </div>
</footer>
</body>
</html>
