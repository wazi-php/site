# Les réglages du site.
#
# Copiez ce fichier sous le nom « .env », puis modifiez-le. Le fichier .env ne
# s'envoie pas dans Git. Chaque réglage peut aussi être donné par une variable
# d'environnement du serveur, qui passe alors avant ce fichier.

# true : le navigateur affiche le message des erreurs, et la barre de débogage.
# À ne JAMAIS activer sur le site en ligne.
APP_DEBUG=false

# Les noms sous lesquels le site répond, séparés par des virgules.
# Vide : tout nom est accepté (pratique sur votre ordinateur, à remplir en ligne).
APP_HOSTS=

# Les adresses de VOS proxies, séparées par des virgules.
# Vide : les en-têtes X-Forwarded-* ne sont jamais crus.
APP_TRUSTED_PROXIES=
